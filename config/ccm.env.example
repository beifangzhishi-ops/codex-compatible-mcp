# Self-hosted CCM OAuth sidecar. Do not commit config/ccm.env.
CCM_SIDECAR_HOST=127.0.0.1
CCM_SIDECAR_PORT=18208
CCM_UPSTREAM_URL=http://127.0.0.1:18209/ccm
# Replace the hostname with the HTTPS origin that exposes this gateway.
CCM_ISSUER=https://your-machine.your-tailnet.ts.net/ccm
CCM_RESOURCE=https://your-machine.your-tailnet.ts.net/ccm/mcp
CCM_STATE_FILE=.state/ccm-oauth-state.json
CCM_UPSTREAM_SESSION_FILE=.state/ccm-upstream-session.json
CCM_APPROVAL_SECRET_FILE=.state/ccm-approval-secret.txt
CCM_LOG_DIR=logs
CCM_TOKEN_TTL_SECONDS=3600
