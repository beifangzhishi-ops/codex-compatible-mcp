{
  "version": 1,
  "rules": [
    {
      "id": "git-remote",
      "platform": "windows",
      "permission_profile": "workspace-write",
      "shells": ["powershell", "pwsh", "cmd"],
      "executables": ["git"],
      "arguments": {
        "type": "subcommand",
        "values": ["clone", "fetch", "pull", "push", "ls-remote"]
      },
      "execution": { "type": "original" }
    },
    {
      "id": "node-test",
      "platform": "windows",
      "permission_profile": "workspace-write",
      "shells": ["powershell", "pwsh"],
      "executables": ["node"],
      "arguments": { "type": "prefix", "tokens": ["--test"] },
      "execution": { "type": "original" }
    },
    {
      "id": "npm-build-native",
      "platform": "windows",
      "permission_profile": "workspace-write",
      "shells": ["powershell", "pwsh", "cmd"],
      "executables": ["npm"],
      "arguments": { "type": "prefix", "tokens": ["run", "build:native"] },
      "execution": { "type": "original" }
    },
    {
      "id": "tailscale",
      "platform": "windows",
      "permission_profile": "workspace-write",
      "shells": ["powershell", "pwsh", "cmd"],
      "executables": ["tailscale"],
      "arguments": { "type": "any" },
      "execution": {
        "type": "pinned",
        "path": "C:\\Program Files\\Tailscale\\tailscale.exe"
      }
    }
  ]
}
