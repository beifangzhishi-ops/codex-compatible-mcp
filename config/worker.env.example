# CCM Remote Worker runtime configuration.
# Copy this file to config/worker.env on each Worker machine.
# config/worker.env is intentionally Git-ignored.

# Controller WorkerHub address reachable from this Worker.
# Prefer a trusted/private network address such as Tailscale.
CCM_WORKER_HUB_CONNECT_HOST=controller.example.invalid
CCM_WORKER_HUB_PORT=18301

# Stable identity advertised to the Controller.
# If omitted, CCM_ENVIRONMENT_ID defaults to the OS hostname and
# CCM_WORKER_ID defaults to the environment id.
CCM_ENVIRONMENT_ID=build-windows
CCM_WORKER_ID=build-windows

# Native working directory and workspace-write boundary.
CCM_WORKSPACE=C:\work\project

# read-only | workspace-write | full-access
CCM_PERMISSION_PROFILE=workspace-write

# CCM_BMG_CLIENT=C:\\path\\to\\browser-mcp-gateway\\bmgctl.cmd

# Delay before reconnecting after the Controller connection drops.
CCM_WORKER_RECONNECT_MS=1000

# Maximum time to wait for the Controller hello_ack before reconnecting.
CCM_WORKER_HANDSHAKE_TIMEOUT_MS=10000

# Worker writes a connected heartbeat at this interval. The supervisor forces
# a restart if the Worker remains disconnected/unhealthy for the timeout below.
CCM_WORKER_HEALTH_INTERVAL_MS=5000
CCM_WORKER_HEALTH_TIMEOUT_MS=30000
